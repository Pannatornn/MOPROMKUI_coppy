# Copy to .env and replace every CHANGE_ME value. Never commit .env.
APP_ENV=production
DOMAIN=team6.105app.site
SECRET_KEY=CHANGE_ME_LONG_RANDOM_VALUE

# PostgreSQL (internal Docker network only)
POSTGRES_DB=morpromkui
POSTGRES_USER=morpromkui
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://morpromkui:CHANGE_ME_DATABASE_PASSWORD@db:5432/morpromkui

# Bootstrap admin account. On first startup this becomes a database-backed admin.
# Generate the hash with: python scripts/make_password_hash.py
# Keep the hash in single quotes because it contains literal $ characters.
STAFF_USERNAME=clinic
STAFF_PASSWORD_HASH='CHANGE_ME_SCRYPT_HASH'

# Gemini Free Tier for a synthetic-data hackathon demo only.
# Never commit or send the key in chat. Free Tier data may be used by Google
# to improve products, so do not enter real patient information.
AI_PROVIDER=gemini
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.6-flash

# Optional OpenAI provider. Change AI_PROVIDER=openai to use it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Clinic / privacy notice
CLINIC_NAME=คลินิกตัวอย่าง
PRIVACY_CONTACT=privacy@example.com
DATA_RETENTION_DAYS=30
CONSENT_VERSION=pilot-1.0

# Single-server rate limiter. Use Redis before horizontal scaling.
RATELIMIT_STORAGE_URI=memory://
